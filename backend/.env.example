# Dev Day — cấu hình backend
# Chép file này thành .env (cùng thư mục backend), rồi sửa 2 dòng có ghi "SỬA".

PROJECT_NAME="Dev Day - TZ Shop"
ENV="local"
DEBUG=True

# SỬA: thay MAT_KHAU_POSTGRES bằng mật khẩu user postgres trên máy bạn.
# Database dev_day sẽ được init_db.py tự tạo.
DATABASE_URL="postgresql+psycopg://postgres:MAT_KHAU_POSTGRES@localhost:5432/dev_day"

# SỬA: chuỗi ngẫu nhiên dài ít nhất 32 ký tự, dùng để ký token đăng nhập.
SECRET_KEY="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TIMEZONE="Asia/Ho_Chi_Minh"
