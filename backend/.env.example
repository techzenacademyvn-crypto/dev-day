# TZ Shop — Environment Template
# Copy this file to .env and fill in all values before running the app.
# Generate SECRET_KEY with: openssl rand -hex 32

PROJECT_NAME="TZ Shop"
ENV="local"
DEBUG=True

# Database connection — must match the credentials in database/.env
DATABASE_URL="postgresql+psycopg://postgres:MAT_KHAU_POSTGRES@localhost:5432/dev_day"

# JWT signing secret — must be a strong random string, never commit the real value
SECRET_KEY="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Timezone
TIMEZONE="Asia/Ho_Chi_Minh"
